# Local SQLite database.
# idf.db is ~110 MB of ingested open data, over GitHub's 100 MB per-file limit,
# and is fully regenerable: `npm run db:setup && npm run ingest:all`.
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
data/

