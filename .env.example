# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# SQLite (default, zero-infra). Path is relative to the prisma/ directory.
DATABASE_URL="file:./idf.db"
# To use PostgreSQL/PostGIS instead, switch the datasource provider in
# prisma/schema.prisma to "postgresql" and use e.g.:
# DATABASE_URL="postgresql://idf:idf@localhost:5432/idf_radar?schema=public"

# Melo / Stream.Estate licensed listings API. Leave blank to run without live
# listings (the app works fully on open data + demo + manual import).
MELO_API_KEY=""

# Single-user MVP: the owner id used for saved properties / filters / alerts.
OWNER_ID="you@example.com"
