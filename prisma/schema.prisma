// IDF Investment Radar — data model.
//
// Provider is SQLite for a zero-infra single-user deployment. Geometry is stored
// as GeoJSON strings + scalar lat/lon; all spatial work (nearest station,
// distance filters, choropleth assembly) is done in TypeScript at IDF scale.
// To scale up, switch the provider to "postgresql" (+ PostGIS) — the app code
// isolates spatial helpers in src/lib/geo so the swap stays local.
//
// MONEY: all monetary columns are integer euro-cents. Arrays/JSON are stored as
// strings (SQLite has no array/native-json Prisma support) and parsed in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Commune {
  id               String   @id @default(cuid())
  code             String   @unique // INSEE code; Paris arrondissements 75101–75120
  nom              String
  departement      String // "75".."95"
  isArrondissement Boolean  @default(false)
  parentCode       String? // arrondissement → "75056"
  population       Int?
  surfaceKm2       Float?
  lon              Float?
  lat              Float?
  geojson          String? // contour geometry (GeoJSON string)

  marketMetrics MarketMetric[]
  saleComps     SaleComparable[]
  properties    Property[]
  neighborhoodMetrics NeighborhoodMetric[]

  @@index([departement])
}

model NeighborhoodMetric {
  id                  String   @id @default(cuid())
  communeCode         String
  period              String
  safetyScore         Int?
  personalSafetyScore Int?
  propertySafetyScore Int?
  streetSafetyScore   Int?
  confidence          String
  population          Int?
  source              String
  sourceUrl           String
  methodologyVersion  String
  computedAt          DateTime @default(now())

  commune Commune @relation(fields: [communeCode], references: [code])

  @@unique([communeCode, period])
  @@index([communeCode])
}

model Station {
  id       String @id @default(cuid())
  idRefZdc String @unique // dedupe key across line rows
  nom      String
  modes    String // comma-joined: RER,METRO,TRAIN,TRAMWAY
  lines    String // comma-joined line indices
  lon      Float
  lat      Float
}

model FutureTransportProject {
  id              String  @id @default(cuid())
  name            String
  line            String // "15","16","17","18","14"
  segment         String?
  lon             Float
  lat             Float
  openingYear     Int? // best-estimate year
  openingLabel    String // human label, e.g. "Autumn 2027"
  status          String // OPEN | UNDER_CONSTRUCTION | PLANNED
  confidence      String // HIGH | MEDIUM | LOW
  source          String
  sourceUrl       String? // official announcement page

  @@unique([name, line])
}

model EmploymentHub {
  id        String @id @default(cuid())
  name      String @unique
  type      String // BUSINESS_DISTRICT | AIRPORT | TECH_CLUSTER | ...
  jobsCount Int?
  lon       Float
  lat       Float
}

model SaleComparable {
  id             String   @id @default(cuid())
  idMutation     String
  rowHash        String   @unique
  dateMutation   DateTime
  natureMutation String
  valeurFonciere Int // cents, mutation-level
  surfaceBati    Float
  typeLocal      String // Appartement | Maison
  pieces         Int?
  prixM2         Int // cents
  codeCommune    String
  lon            Float
  lat            Float

  commune Commune @relation(fields: [codeCommune], references: [code])

  @@index([codeCommune, dateMutation])
  @@index([typeLocal])
}

model RentReference {
  id                String  @id @default(cuid())
  scope             String // COMMUNE | PARIS_QUARTIER
  codeCommune       String?
  codeGrandQuartier String?
  segment           String // ALL_APT | T1_T2 | T3_PLUS | HOUSE | piece count
  epoque            String?
  meuble            Boolean?
  rentM2Pred        Int // cents / m² / month
  rentM2Low         Int?
  rentM2High        Int?
  typPred           String? // commune | maille
  nbObs             Int?
  r2Adj             Float?
  year              Int

  @@index([codeCommune, segment])
  @@index([codeGrandQuartier])
}

model MarketMetric {
  id            String @id @default(cuid())
  communeCode   String
  period        String // "2021-2025"
  segment       String // ALL | APT | HOUSE
  medianPriceM2 Int? // cents
  p25PriceM2    Int?
  p75PriceM2    Int?
  medianRentM2  Int? // cents
  estGrossYield Float?
  dvfSampleSize Int    @default(0)
  priceTrend5y  Float?

  rentalDemandScore Int?
  transportScore    Int?
  appreciationScore Int?
  hotspotScore      Int?

  computedAt DateTime @default(now())

  commune Commune @relation(fields: [communeCode], references: [code])

  @@unique([communeCode, period, segment])
}

model PropertySource {
  id       String    @id @default(cuid())
  key      String    @unique // melo | manual | demo
  label    String
  enabled  Boolean   @default(true)
  config   String? // JSON string
  listings Listing[]
}

model Property {
  id           String  @id @default(cuid())
  dedupeKey    String  @unique
  addressLine  String?
  codeCommune  String?
  lon          Float?
  lat          Float?
  surface      Float?
  rooms        Int?
  propertyType String? // Appartement | Maison
  dpe          String?
  ges          String?
  floor        Int?
  hasElevator  Boolean?
  isDemo       Boolean @default(false)

  commune  Commune?             @relation(fields: [codeCommune], references: [code])
  listings Listing[]
  analyses InvestmentAnalysis[]
  saved    SavedProperty[]

  @@index([codeCommune])
}

model Listing {
  id           String   @id @default(cuid())
  sourceId     String
  externalId   String
  url          String?
  title        String?
  description  String?
  price        Int // cents
  charges      Int? // monthly copro charges
  taxeFonciere Int? // annual
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  daysOnMarket Int?
  status       String   @default("ACTIVE") // ACTIVE | SOLD | WITHDRAWN
  propertyId   String

  // Who is advertising: AGENCY | INDIVIDUAL | UNKNOWN. Only ever set from an
  // explicit signal (publisher domain, portal badge, or named advertiser) —
  // see src/lib/sources/sellerType.ts. UNKNOWN is a real answer, not a default
  // to be filled in by guessing.
  sellerType String  @default("UNKNOWN")
  sellerName String? // advertiser name when the advert states one

  property     Property       @relation(fields: [propertyId], references: [id])
  source       PropertySource @relation(fields: [sourceId], references: [id])
  priceHistory PriceHistory[]

  @@unique([sourceId, externalId])
  @@index([propertyId])
  @@index([sellerType])
}

model PriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  observedAt DateTime @default(now())
  price      Int

  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId, observedAt])
}

model AssumptionSet {
  id                String  @id @default(cuid())
  scope             String // GLOBAL | USER | PROPERTY
  ownerId           String?
  ratePct           Float   @default(3.6)
  termYears         Int     @default(25)
  financingPct      Float   @default(110)
  downPaymentCents  Int?
  insurancePct      Float   @default(0.3)
  notaryPct         Float   @default(7.5)
  agencyPct         Float   @default(0)
  guaranteeFeesCents Int    @default(0)
  bankFeesCents     Int     @default(100000)
  renovationCents   Int     @default(0)
  furnitureCents    Int     @default(0)
  vacancyPct        Float   @default(5)
  maintenancePct    Float   @default(5)
  managementPct     Float   @default(0)
  otherMonthlyCents Int     @default(0)
  rentScenario      String  @default("MARKET")
  hash              String  @unique

  analyses InvestmentAnalysis[]
}

model InvestmentAnalysis {
  id              String   @id @default(cuid())
  propertyId      String
  assumptionHash  String
  monthlyCashFlow Int // cents
  noiAnnual       Int
  dscr            Float
  grossYield      Float
  allInGrossYield Float
  netYield        Float
  investorCash    Int
  whiteStatus     String
  breakEvenFull   Int?
  breakEvenStrong Int?
  investmentScore Int
  scoresJson      String // JSON string of all sub-scores
  computedAt      DateTime @default(now())
  stale           Boolean  @default(false)

  property    Property      @relation(fields: [propertyId], references: [id])
  assumptions AssumptionSet @relation(fields: [assumptionHash], references: [hash])

  @@unique([propertyId, assumptionHash])
}

model SavedProperty {
  id         String   @id @default(cuid())
  ownerId    String
  propertyId String
  note       String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@unique([ownerId, propertyId])
}

model SavedFilter {
  id       String  @id @default(cuid())
  ownerId  String
  name     String
  filter   String // JSON string of PropertyFilter
  isPreset Boolean @default(false)

  @@unique([ownerId, name])
}

model Alert {
  id        String    @id @default(cuid())
  ownerId   String
  filterId  String
  cadence   String    @default("DAILY")
  lastRunAt DateTime?
  channel   String    @default("IN_APP")
}

model IngestRun {
  id         String    @id @default(cuid())
  job        String
  key        String
  status     String
  rows       Int?
  etag       String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([job, key])
}
